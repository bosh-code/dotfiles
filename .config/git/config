# Load personal by default
[include]
  path = ~/.local/share/git/personal.gitconfig

# Override with work when in the work directory
[includeIf "gitdir:~/Work/**"]
  path = ~/.local/share/git/work.gitconfig

# Other includes
[include]
  path = ./delta.gitconfig

# All other shared config that isn't sensitive
[hub]
  protocol = ssh

[core]
  autocrlf = input
  filemode = false

[push]
  autoSetupRemote = true

[pull]
	rebase = true
