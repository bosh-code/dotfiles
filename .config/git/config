#
# Shared git config. Machine specific overrides should go in ~/.gitconfig.
#

[includeIf "gitdir:~/Work/**"]
  path = ~/.local/share/git/work.gitconfig

[include]
  path = ~/.local/share/git/personal.gitconfig

[include]
  path = ./delta.gitconfig

[user]
  machine = computer # or server

[init]
  defaultBranch = main

[hub]
  protocol = ssh

[core]
  autocrlf = input
  filemode = false

[push]
  autoSetupRemote = true

[pull]
	rebase = true
