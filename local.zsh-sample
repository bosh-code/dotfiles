#!/usr/bin/env zsh
#
# local.zsh - local zsh configuration that is not meant to be shared across machines.
#

# echo "[debug] ~/.config/zsh/local.zsh loaded at: $(date +%T.%N) with PID $$ from $0" >&2

# TODO: Make this a typed array or something similar to easily check if a feature is enabled or not.

DOTFILES_MISE_ENABLED=1
DOTFILES_FNOX_ENABLED=1
DOTFILES_PITCHFORK_ENABLED=1
DOTFILES_GST_ON_EMPTY_ENABLED=1
DOTFILES_HOMEBREW_ENABLED=1
DOTFILES_ANDROID_ENABLED=1
DOTFILES_DOCKER_ENABLED=1
DOTFILES_CONTAINER_ENABLED=1
DOTFILES_DOTNET_ENABLED=1
