#!/usr/bin/env zsh
#
# pbmd - copy a file to the clipboard as a Markdown code block.
#

emulate -L zsh
setopt extended_glob

: ${PBMD_MAX_BYTES:=512000}   # 500 KB

_pbmd_usage() {
  cat <<'EOF'
██████╗ ██████╗ ███╗   ███╗██████╗ 
██╔══██╗██╔══██╗████╗ ████║██╔══██╗
██████╔╝██████╔╝██╔████╔██║██║  ██║
██╔═══╝ ██╔══██╗██║╚██╔╝██║██║  ██║
██║     ██████╔╝██║ ╚═╝ ██║██████╔╝
╚═╝     ╚═════╝ ╚═╝     ╚═╝╚═════╝ 

pbmd - pasteboard markdown
Copy a file to the clipboard as a Markdown code block.

The language tag is inferred from the file extension, basename, or shebang
line. The file path is included as a comment on the first line of the
block, or as a backticked header above the block when the language has no
single-line comment syntax.

Usage:
  pbmd [options] <file> [<file>...]
  pbmd [options] --stdin -l <lang>

Options:
  -e, --echo            Also print the result to stdout.
  -t, --trim            Use just the basename in the header.
  -r, --relative        Use a path relative to cwd (or git root if available).
  -n, --no-header       Omit the filename header.
  -l, --lang LANG       Force a language tag (applies to all inputs).
  -v, --verbose         Print debug info to stderr; implies --echo.
      --stdin           Read from stdin instead of file arguments.
      --no-copy         Don't copy to clipboard (handy with --echo).
  -h, --help            Show this help.

Environment:
  PBMD_MAX_BYTES        Per-file size limit in bytes (default 512000 = 500KB).
  PBMD_DEFAULT_FLAGS    Flags prepended to every invocation. Example:
                          export PBMD_DEFAULT_FLAGS="-r -e"

Examples:
  pbmd ~/.config/zsh/.zshenv
  pbmd -t -e src/index.ts
  pbmd -r src/**/*.ts
  pbmd -l python --stdin < snippet.txt
  PBMD_DEFAULT_FLAGS="-r" pbmd README.md
EOF
}

# ---------------------------------------------------------------------------
# Apply PBMD_DEFAULT_FLAGS, then parse arguments.
# ---------------------------------------------------------------------------
if [[ -n $PBMD_DEFAULT_FLAGS ]]; then
  set -- ${=PBMD_DEFAULT_FLAGS} "$@"
fi

local opt_echo=0 opt_trim=0 opt_relative=0 opt_no_header=0 opt_no_copy=0 opt_stdin=0 opt_verbose=0
local opt_lang=""
local -a files
local -a raw_args=("$@")

while (( $# )); do
  case $1 in
    -e|--echo)        opt_echo=1 ;;
    -t|--trim)        opt_trim=1 ;;
    -r|--relative)    opt_relative=1 ;;
    -n|--no-header)   opt_no_header=1 ;;
    -v|--verbose)     opt_verbose=1; opt_echo=1 ;;
    --no-copy)        opt_no_copy=1 ;;
    --stdin)          opt_stdin=1 ;;
    -l|--lang)
      shift
      if (( $# == 0 )); then
        print -u2 "pbmd: -l/--lang requires an argument"
        return 2 2>/dev/null || exit 2
      fi
      opt_lang=$1
      ;;
    -h|--help)
      _pbmd_usage
      return 0 2>/dev/null || exit 0
      ;;
    --)
      shift
      files+=("$@")
      break
      ;;
    -*)
      print -u2 "pbmd: unknown option: $1"
      print -u2 "try: pbmd --help"
      return 2 2>/dev/null || exit 2
      ;;
    *)
      files+=("$1")
      ;;
  esac
  shift
done

if (( opt_stdin )); then
  if (( ${#files} > 0 )); then
    print -u2 "pbmd: --stdin cannot be combined with file arguments"
    return 2 2>/dev/null || exit 2
  fi
elif (( ${#files} == 0 )); then
  _pbmd_usage
  return 2 2>/dev/null || exit 2
fi

# ---------------------------------------------------------------------------
# Verbose preamble
# ---------------------------------------------------------------------------
# _pbmd_vlog() {
#   (( opt_verbose )) && print -u2 -r -- "[pbmd] $*"
# }

_pbmd_vlog() {
  (( opt_verbose )) || return 0
  print -u2 -r -- "[pbmd] $*"
}

if (( opt_verbose )); then
  _pbmd_vlog "version: dev"
  _pbmd_vlog "PBMD_DEFAULT_FLAGS = ${PBMD_DEFAULT_FLAGS:-(unset)}"
  _pbmd_vlog "PBMD_MAX_BYTES     = ${PBMD_MAX_BYTES}"
  _pbmd_vlog "raw args (after defaults): ${(j: :)raw_args}"
  _pbmd_vlog "flags: echo=$opt_echo trim=$opt_trim relative=$opt_relative no_header=$opt_no_header no_copy=$opt_no_copy stdin=$opt_stdin lang=${opt_lang:-(auto)}"
  _pbmd_vlog "files: ${(j:, :)files:-<stdin>}"
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_pbmd_lang_for() {
  local file=$1
  local base=${file:t}
  local ext=${file:e:l}

  case $base in
    Dockerfile|*.dockerfile|Containerfile)             print -r -- dockerfile; return ;;
    docker-compose.yml|docker-compose.yaml|compose.yml|compose.yaml) print -r -- yaml; return ;;
    Makefile|GNUmakefile|makefile)                     print -r -- make;       return ;;
    Justfile|justfile|.justfile)                       print -r -- just;       return ;;
    Rakefile|Gemfile|Brewfile|Berksfile|Vagrantfile|Capfile|Guardfile|Podfile|Fastfile|Appfile|Matchfile|Deliverfile|Snapfile)
                                                       print -r -- ruby;       return ;;
    Procfile|Caddyfile)                                print -r -- "";         return ;;
    CMakeLists.txt|*.cmake)                            print -r -- cmake;      return ;;

    .zshrc|.zshenv|.zprofile|.zlogin|.zlogout|.zsh_aliases|.zshrc.local) print -r -- zsh;  return ;;
    .bashrc|.bash_profile|.bash_aliases|.bash_logout|.profile|.inputrc)   print -r -- bash; return ;;

    .gitconfig|.gitignore|.gitattributes|.gitmodules|.gitkeep|.mailmap)
                                                       print -r -- gitconfig;   return ;;

    CODEOWNERS|FUNDING.yml|FUNDING.yaml)               print -r -- "";          return ;;
    dependabot.yml|dependabot.yaml|renovate.json|renovate.json5|.renovaterc|.renovaterc.json)
                                                       print -r -- jsonc;       return ;;

    .editorconfig)                                     print -r -- editorconfig; return ;;
    .env|.env.*)                                       print -r -- dotenv;       return ;;
    .npmrc|.yarnrc|.pnpmrc|.bunfig.toml)               print -r -- ini;          return ;;
    .nvmrc|.node-version|.python-version|.ruby-version|.tool-versions|.terraform-version|.java-version)
                                                       print -r -- "";          return ;;

    tsconfig*.json|jsconfig*.json|.babelrc|.babelrc.json|.swcrc|.eslintrc|.eslintrc.json|.prettierrc|.prettierrc.json|.stylelintrc|.stylelintrc.json|biome.json|biome.jsonc)
                                                       print -r -- jsonc;       return ;;

    package-lock.json|composer.lock)                   print -r -- json;        return ;;
    yarn.lock|pnpm-lock.yaml)                          print -r -- yaml;        return ;;
    Cargo.lock|Pipfile.lock|poetry.lock|uv.lock)       print -r -- toml;        return ;;
    Gemfile.lock|go.sum|go.mod)                        print -r -- "";          return ;;

    Podfile.lock)                                      print -r -- yaml;        return ;;
    *.pbxproj|*.xcconfig)                              print -r -- "";          return ;;
    Package.swift|Package.resolved)                    print -r -- swift;       return ;;

    gradlew|gradlew.bat)                               print -r -- bash;        return ;;
    gradle.properties|local.properties)                print -r -- properties;  return ;;
    AndroidManifest.xml)                               print -r -- xml;         return ;;
    proguard-rules.pro)                                print -r -- "";          return ;;

    LICENSE|LICENCE|COPYING|AUTHORS|CHANGELOG|CONTRIBUTING|README|TODO|NOTICE|MAINTAINERS|SECURITY)
                                                       print -r -- "";          return ;;
  esac

  if [[ $file == */.vscode/*.json ]]; then
    print -r -- jsonc; return
  fi

  case $ext in
    sh|bash)                        print -r -- bash ;;
    zsh)                            print -r -- zsh ;;
    fish)                           print -r -- fish ;;
    ps1|psm1|psd1)                  print -r -- powershell ;;
    bat|cmd)                        print -r -- batch ;;

    py|pyi|pyw)                     print -r -- python ;;
    rb|rake|gemspec)                print -r -- ruby ;;
    pl|pm)                          print -r -- perl ;;
    lua)                            print -r -- lua ;;
    r)                              print -r -- r ;;
    jl)                             print -r -- julia ;;

    js|mjs|cjs)                     print -r -- javascript ;;
    ts|mts|cts)                     print -r -- typescript ;;
    jsx)                            print -r -- jsx ;;
    tsx)                            print -r -- tsx ;;
    vue)                            print -r -- vue ;;
    svelte)                         print -r -- svelte ;;
    astro)                          print -r -- astro ;;

    go)                             print -r -- go ;;
    rs)                             print -r -- rust ;;
    java)                           print -r -- java ;;
    kt|kts)                         print -r -- kotlin ;;
    swift)                          print -r -- swift ;;
    scala|sbt)                      print -r -- scala ;;
    c|h)                            print -r -- c ;;
    cpp|cc|cxx|hpp|hxx)             print -r -- cpp ;;
    cs|csx)                         print -r -- csharp ;;
    fs|fsx|fsi)                     print -r -- fsharp ;;
    vb)                             print -r -- vbnet ;;
    php|phtml)                      print -r -- php ;;
    dart)                           print -r -- dart ;;
    zig)                            print -r -- zig ;;
    nim)                            print -r -- nim ;;
    ex|exs)                         print -r -- elixir ;;
    erl|hrl)                        print -r -- erlang ;;
    clj|cljs|cljc|edn)              print -r -- clojure ;;
    hs|lhs)                         print -r -- haskell ;;
    ml|mli)                         print -r -- ocaml ;;

    m|mm)                           print -r -- objectivec ;;
    plist|storyboard|xib|entitlements) print -r -- xml ;;

    gradle)                         print -r -- groovy ;;
    groovy|gvy)                     print -r -- groovy ;;
    properties)                     print -r -- properties ;;
    aidl)                           print -r -- java ;;

    sln|slnx)                       print -r -- "" ;;
    csproj|vbproj|fsproj|vcxproj|shproj|proj|props|targets|nuspec)
                                    print -r -- xml ;;
    resx|axml|xaml|xsd|xsl|xslt)    print -r -- xml ;;
    razor|cshtml|vbhtml)            print -r -- razor ;;
    config)                         print -r -- xml ;;
    runsettings|ruleset|stylecop)   print -r -- xml ;;

    html|htm|xhtml)                 print -r -- html ;;
    ejs)                            print -r -- ejs ;;
    hbs|handlebars)                 print -r -- handlebars ;;
    pug|jade)                       print -r -- pug ;;
    njk|nunjucks)                   print -r -- nunjucks ;;
    liquid)                         print -r -- liquid ;;
    twig)                           print -r -- twig ;;
    mustache)                       print -r -- mustache ;;

    css)                            print -r -- css ;;
    scss|sass)                      print -r -- scss ;;
    less)                           print -r -- less ;;
    styl|stylus)                    print -r -- stylus ;;
    pcss|postcss)                   print -r -- css ;;

    json)                           print -r -- json ;;
    jsonc)                          print -r -- jsonc ;;
    json5)                          print -r -- json5 ;;
    jsonl|ndjson)                   print -r -- json ;;
    yaml|yml)                       print -r -- yaml ;;
