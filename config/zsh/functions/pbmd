    xml|svg)                        print -r -- xml ;;
    csv)                            print -r -- csv ;;
    tsv)                            print -r -- tsv ;;
    ini|cfg|conf)                   print -r -- ini ;;

    md|markdown)                    print -r -- markdown ;;
    mdx)                            print -r -- mdx ;;
    rst)                            print -r -- rst ;;
    adoc|asciidoc)                  print -r -- asciidoc ;;
    org)                            print -r -- org ;;
    tex|sty|cls)                    print -r -- latex ;;
    bib)                            print -r -- bibtex ;;

    sql|psql|mysql)                 print -r -- sql ;;
    graphql|gql)                    print -r -- graphql ;;
    proto)                          print -r -- protobuf ;;
    prisma)                         print -r -- prisma ;;

    tf|tfvars|hcl)                  print -r -- hcl ;;
    nix)                            print -r -- nix ;;
    dhall)                          print -r -- dhall ;;

    vim)                            print -r -- vim ;;
    el)                             print -r -- elisp ;;
    diff|patch)                     print -r -- diff ;;
    log)                            print -r -- log ;;
    txt)                            print -r -- "" ;;
    wat)                            print -r -- wasm ;;

    *)                              print -r -- "" ;;
  esac
}

# Inspect the first line of a file for a shebang and map it to a language.
# Only called when extension/basename detection returned empty.
_pbmd_lang_from_shebang() {
  local file=$1
  local first
  IFS= read -r first < "$file" 2>/dev/null || return
  [[ $first == '#!'* ]] || return

  case $first in
    *zsh*)              print -r -- zsh ;;
    *bash*)             print -r -- bash ;;
    *' sh'|*'/sh'|*'/sh '*) print -r -- bash ;;
    *fish*)             print -r -- fish ;;
    *python*)           print -r -- python ;;
    *node*|*deno*|*bun*) print -r -- javascript ;;
    *ruby*)             print -r -- ruby ;;
    *perl*)             print -r -- perl ;;
    *lua*)              print -r -- lua ;;
    *php*)              print -r -- php ;;
    *Rscript*)          print -r -- r ;;
    *tclsh*|*wish*)     print -r -- tcl ;;
    *osascript*)        print -r -- applescript ;;
    *)                  print -r -- "" ;;
  esac
}

_pbmd_comment_for() {
  case $1 in
    bash|zsh|fish|sh|python|ruby|perl|make|cmake|just|dockerfile|yaml|toml|ini|properties|gitconfig|editorconfig|dotenv|nix|hcl|conf|powershell|r|julia|elixir|nim|prisma|graphql|tcl|applescript)
      print -r -- "# " ;;
    javascript|typescript|jsx|tsx|vue|svelte|astro|go|rust|java|kotlin|swift|scala|groovy|c|cpp|csharp|fsharp|vbnet|objectivec|php|dart|zig|less|stylus|css|scss|jsonc|json5|proto|protobuf|dhall)
      print -r -- "// " ;;
    sql|lua|haskell)        print -r -- "-- " ;;
    clojure|elisp)          print -r -- ";; " ;;
    erlang)                 print -r -- "%% " ;;
    latex|bibtex)           print -r -- "% " ;;
    vim)                    print -r -- '" ' ;;
    batch)                  print -r -- ":: " ;;
    html|xml|markdown|mdx|ejs|handlebars|nunjucks|liquid|twig|mustache|razor)
                            print -r -- "<!-- " ;;
    pug)                    print -r -- "// " ;;
    json|csv|tsv|log|"")    print -r -- "" ;;
    *)                      print -r -- "# " ;;
  esac
}

_pbmd_size_of() {
  stat -f%z -- "$1" 2>/dev/null || stat -c%s -- "$1" 2>/dev/null
}

_pbmd_display_path() {
  local f=$1
  if (( opt_trim )); then
    print -r -- "${f:t}"
  elif (( opt_relative )); then
    local abs="${f:A}"
    local root
    root=$(git -C "${f:h}" rev-parse --show-toplevel 2>/dev/null)
    if [[ -n $root && $abs == $root/* ]]; then
      print -r -- "${abs#$root/}"
    elif [[ $abs == $PWD/* ]]; then
      print -r -- "${abs#$PWD/}"
    else
      print -r -- "$f"
    fi
  else
    print -r -- "$f"
  fi
}

# Pick a fence with enough backticks to safely wrap the content.
_pbmd_fence_for() {
  local content=$1
  local longest=0 run=0 i ch
  for (( i = 1; i <= ${#content}; i++ )); do
    ch=${content[i]}
    if [[ $ch == '`' ]]; then
      (( run++ ))
      (( run > longest )) && longest=$run
    else
      run=0
    fi
  done
  local n=3
  (( longest >= 3 )) && n=$((longest + 1))
  local fence=""
  for (( i = 0; i < n; i++ )); do fence+='`'; done
  print -r -- "$fence"
}

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
local out="" lang lang_source comment fence size content display

if (( opt_stdin )); then
  content=$(cat)
  lang=${opt_lang:-""}
  fence=$(_pbmd_fence_for "$content")
  _pbmd_vlog "stdin: ${#content} bytes, lang=${lang:-(none)}, fence=${#fence} backticks"
  out+="${fence}${lang}"$'\n'
  out+="${content}"$'\n'
  out+="${fence}"$'\n'
else
  local f
  for f in "${files[@]}"; do
    if [[ ! -r $f ]]; then
      print -u2 "pbmd: cannot read: $f"
      return 1 2>/dev/null || exit 1
    fi

    size=$(_pbmd_size_of "$f")
    if [[ -n $size ]] && (( size > PBMD_MAX_BYTES )); then
      print -u2 "pbmd: refusing to copy '$f' (${size} bytes > ${PBMD_MAX_BYTES} byte limit)"
      print -u2 "      override with: PBMD_MAX_BYTES=$((size + 1)) pbmd $f"
      return 1 2>/dev/null || exit 1
    fi

    if [[ -n $opt_lang ]]; then
      lang=$opt_lang
      lang_source="forced"
    else
      lang=$(_pbmd_lang_for "$f")
      lang_source="extension/basename"
      if [[ -z $lang ]]; then
        lang=$(_pbmd_lang_from_shebang "$f")
        [[ -n $lang ]] && lang_source="shebang"
      fi
      [[ -z $lang ]] && lang_source="none"
    fi

    comment=$(_pbmd_comment_for "$lang")
    content=$(<"$f")
    fence=$(_pbmd_fence_for "$content")
    display=$(_pbmd_display_path "$f")

    _pbmd_vlog "file: $f"
    _pbmd_vlog "  size=${size:-?} bytes  lang=${lang:-(none)} (via $lang_source)  display='$display'  fence=${#fence} backticks"

    if (( opt_no_header )); then
      out+="${fence}${lang}"$'\n'
    elif [[ -z $comment ]]; then
      out+="\`${display}\`:"$'\n'
      out+="${fence}${lang}"$'\n'
    else
      out+="${fence}${lang}"$'\n'
      if [[ $comment == "<!-- " ]]; then
        out+="${comment}${display} -->"$'\n'
      else
        out+="${comment}${display}"$'\n'
      fi
    fi

    out+="${content}"$'\n'
    out+="${fence}"$'\n'
  done
fi

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if (( ! opt_no_copy )); then
  print -rn -- "$out" | pbcopy
  _pbmd_vlog "copied ${#out} bytes to clipboard via pbcopy"
else
  _pbmd_vlog "skipped clipboard copy (--no-copy)"
fi

if (( opt_echo )); then
  print -rn -- "$out"
fi
