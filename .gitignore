#
# .env
#
.env


#
# config/
#

# Ignore all children of config by default
config/*

# Re-include select dirs
!config/cowfiles/
!config/direnv/
!config/fnox/
!config/ghostty/
!config/git/
!config/homebrew/
!config/mise/
!config/pitchfork/

# btop
!config/btop/
config/btop/*
!config/btop/themes/
!config/btop/btop.conf

# nushell
!config/nushell/
config/nushell/*
!config/nushell/config.nu
!config/nushell/env.nu

# openlogi
!config/openlogi/
config/openlogi/*
!config/openlogi/config.toml

# tabby
!config/tabby/
config/tabby/*
!config/tabby/config.yaml
!config/tabby/config.yaml.backup

# xonsh
!config/xonsh/
config/xonsh/*
!config/xonsh/rc.d/

# yarn
!config/.yarnrc.yml

# zed
!config/zed/
config/zed/prompts
config/zed/themes

# zsh
!config/zsh/
# Ignore generated files
config/zsh/.zsh_history
config/zsh/.zsh_sessions/
config/zsh/completions/
# Ignore local zsh config
config/zsh/local.zsh


#
# ssh/
#

# Only check in the ssh config, ignore the rest of the
ssh/
!ssh/config

# Ignore keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub


#
# git
#

# Ignore root level git config
home/.gitconfig


#
# zsh
#

# Ignore compiled zsh files
.zsh_plugins.zsh
*.zwc
*.zwc.old
.zcompdump


#
# misc
#

# Ignore IDE and OS files
.idea/
.DS_Store
