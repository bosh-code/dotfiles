#
# .env
#
.env


#
# .config/
#

# Ignore all children of .config by default
.config/*

# Re-include select dirs
!.config/cowfiles/
!.config/fnox/
!.config/ghostty/
!.config/git/
!.config/pitchfork/

# loose .config/* files
# yarn
!.config/.yarnrc.yml
# flutter (terrible filename)
!.config/settings

# btop
!.config/btop/
.config/btop/*
!.config/btop/themes/
!.config/btop/btop.conf

# nushell
!.config/nushell/
.config/nushell/*
!.config/nushell/config.nu
!.config/nushell/env.nu

# xonsh
!.config/xonsh/
.config/xonsh/*
!.config/xonsh/rc.d/

# zed
!.config/zed/
.config/zed/prompts
.config/zed/themes

# zsh
!.config/zsh/
# Ignore generated files
.config/zsh/.zsh_history
.config/zsh/.zsh_sessions/
.config/zsh/completions/

#
# .ssh/
#

# Ignore 1password config file SSH known hosts files
# The 1password file just contains the socket stuff and is generated.
.ssh/1password.conf
.ssh/authorized_keys
.ssh/known_hosts
.ssh/known_hosts.old

# Ignore keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub

#
# git
#

# Ignore root level git config
/.gitconfig

#
# zsh
#

# Ignore compiled zsh files
.zsh_plugins.zsh
*.zwc
*.zwc.old
.zcompdump

#
# misc
#

# Ignore IDE and OS files
.idea/
.DS_Store
